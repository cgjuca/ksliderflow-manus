<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teste de Perfil Comportamental - Líder Flow</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #050b18;
            --accent-blue: #00d2ff;
            --accent-purple: #7000ff;
            --text-light: #e0e6ed;
            --card-bg: rgba(255, 255, 255, 0.05);
            --acao: #ff4b2b;
            --inspiracao: #ffb400;
            --harmonia: #2ecc71;
            --clareza: #3498db;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(0, 210, 255, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(112, 0, 255, 0.05) 0%, transparent 40%);
            color: var(--text-light);
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Background Animated Neural Connections (Simulação Visual) */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');
            opacity: 0.1;
            z-index: -1;
        }

        #quiz-container {
            width: 90%;
            max-width: 700px;
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            position: relative;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
        }

        h1 {
            font-weight: 800;
            font-size: 1.8rem;
            letter-spacing: -1px;
            background: linear-gradient(to right, #fff, var(--accent-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            margin: 20px 0;
            overflow: hidden;
        }

        #progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
            transition: width 0.4s ease;
        }

        .question-card {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .question-card.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .question-text {
            font-size: 1.3rem;
            margin-bottom: 30px;
            line-height: 1.4;
            text-align: center;
            font-weight: 300;
        }

        .options-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .option-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            flex: 1;
        }

        .option-label input {
            display: none;
        }

        .radio-custom {
            width: 50px;
            height: 50px;
            border: 2px solid rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 600;
            transition: all 0.2s ease;
            margin-bottom: 8px;
            background: rgba(255,255,255,0.05);
        }

        .option-label:hover .radio-custom {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .option-label input:checked + .radio-custom {
            background: var(--accent-blue);
            border-color: var(--accent-blue);
            color: var(--bg-dark);
            box-shadow: 0 0 15px var(--accent-blue);
        }

        .scale-text {
            font-size: 0.7rem;
            text-transform: uppercase;
            opacity: 0.6;
            text-align: center;
        }

        /* Result Styles */
        #result-container {
            display: none;
            text-align: center;
        }

        .result-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 30px;
        }

        .result-item {
            background: rgba(255,255,255,0.03);
            padding: 20px;
            border-radius: 15px;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .bar-outer {
            width: 100%;
            height: 12px;
            background: rgba(0,0,0,0.3);
            border-radius: 6px;
            margin-top: 10px;
        }

        .bar-inner {
            height: 100%;
            border-radius: 6px;
            width: 0%;
            transition: width 1.5s cubic-bezier(0.17, 0.67, 0.83, 0.67);
        }

        .profile-title {
            font-weight: 600;
            margin-bottom: 15px;
            display: block;
        }

        .winner-box {
            margin-top: 40px;
            padding: 25px;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(112, 0, 255, 0.1), rgba(0, 210, 255, 0.1));
            border: 1px solid var(--accent-blue);
        }

        .btn-restart {
            margin-top: 30px;
            padding: 12px 30px;
            border-radius: 30px;
            border: none;
            background: var(--accent-blue);
            color: var(--bg-dark);
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .btn-restart:hover {
            transform: scale(1.05);
        }

        @media (max-width: 600px) {
            .options-container { flex-wrap: wrap; justify-content: center; }
            .radio-custom { width: 40px; height: 40px; }
            .result-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div id="quiz-container">
    <header>
        <h1>Líder Flow Profile</h1>
        <div class="progress-bar"><div id="progress-fill"></div></div>
    </header>

    <div id="questions-wrapper">
        </div>

    <div id="result-container">
        <h2>Seu Perfil Resultante</h2>
        <div class="result-grid">
            <div class="result-item">
                <span class="profile-title">Ação (Executor)</span>
                <div class="bar-outer"><div id="bar-acao" class="bar-inner" style="background: var(--acao)"></div></div>
            </div>
            <div class="result-item">
                <span class="profile-title">Inspiração (Comunicador)</span>
                <div class="bar-outer"><div id="bar-inspiracao" class="bar-inner" style="background: var(--inspiracao)"></div></div>
            </div>
            <div class="result-item">
                <span class="profile-title">Harmonia (Planejador)</span>
                <div class="bar-outer"><div id="bar-harmonia" class="bar-inner" style="background: var(--harmonia)"></div></div>
            </div>
            <div class="result-item">
                <span class="profile-title">Clareza (Analista)</span>
                <div class="bar-outer"><div id="bar-clareza" class="bar-inner" style="background: var(--clareza)"></div></div>
            </div>
        </div>

        <div id="winner-summary" class="winner-box">
            </div>

        <button class="btn-restart" onclick="location.reload()">Refazer Teste</button>
    </div>
</div>

<script>
    const questions = [
        { id: 1, type: 'acao', text: "Quando surge um problema urgente, ajo rapidamente para resolver." },
        { id: 2, type: 'inspiracao', text: "Gosto de conversar e trocar ideias antes de tomar decisões." },
        { id: 3, type: 'harmonia', text: "Prefiro seguir rotinas e métodos já testados, pois me sinto mais seguro(a)." },
        { id: 4, type: 'clareza', text: "Tenho o hábito de revisar meu trabalho para garantir que tudo esteja correto." },
        { id: 5, type: 'acao', text: "Gosto de assumir o comando e fazer as coisas acontecerem." },
        { id: 6, type: 'inspiracao', text: "Sou motivado(a) por um ambiente leve, colaborativo e positivo." },
        { id: 7, type: 'harmonia', text: "Prefiro planejar bem antes de começar uma tarefa nova." },
        { id: 8, type: 'clareza', text: "Analiso todas as informações com atenção e lógica antes de decidir." },
        { id: 9, type: 'acao', text: "Prefiro ter autonomia total para decidir o que fazer." },
        { id: 10, type: 'inspiracao', text: "Tenho facilidade em envolver as pessoas e gerar entusiasmo." },
        { id: 11, type: 'harmonia', text: "Gosto de ajudar o time a manter a harmonia e o clima equilibrado." },
        { id: 12, type: 'clareza', text: "Consigo identificar possíveis falhas e agir preventivamente." },
        { id: 13, type: 'acao', text: "Se algo não sai como o planejado, ajusto o rumo e sigo em frente." },
        { id: 14, type: 'inspiracao', text: "Tenho facilidade para lidar com diferentes pessoas e estilos." },
        { id: 15, type: 'harmonia', text: "Prefiro ambientes previsíveis, onde sei o que esperar." },
        { id: 16, type: 'clareza', text: "Sou exigente comigo mesmo(a) e busco entregar com qualidade." }
    ];

    const profilesData = {
        acao: { title: "Ação (Executor)", desc: "Focado em resultados, direto e competitivo. Você é a força motriz que tira os projetos do papel e foca na eficiência." },
        inspiracao: { title: "Inspiração (Comunicador)", desc: "Criativo, entusiasta e sociável. Você brilha ao conectar pessoas, vender ideias e manter o time motivado." },
        harmonia: { title: "Harmonia (Planejador)", desc: "Calmo, cooperativo e valoriza estabilidade. Você é o alicerce que garante que os processos fluam sem conflitos e com constância." },
        clareza: { title: "Clareza (Analista)", desc: "Analítico, detalhista e busca precisão. Você garante a qualidade técnica e a segurança através de dados e lógica." }
    };

    let currentStep = 0;
    const scores = { acao: 0, inspiracao: 0, harmonia: 0, clareza: 0 };

    const wrapper = document.getElementById('questions-wrapper');

    function initQuiz() {
        questions.forEach((q, index) => {
            const card = document.createElement('div');
            card.className = `question-card ${index === 0 ? 'active' : ''}`;
            card.id = `q-${index}`;
            card.innerHTML = `
                <p class="question-text">${q.text}</p>
                <div class="options-container">
                    ${[1, 2, 3, 4, 5].map(num => `
                        <label class="option-label">
                            <input type="radio" name="q${index}" value="${num}" onclick="handleSelection(${index}, ${num}, '${q.type}')">
                            <span class="radio-custom">${num}</span>
                            <span class="scale-text">${num === 1 ? 'Nada a ver' : num === 5 ? 'Totalmente' : ''}</span>
                        </label>
                    `).join('')}
                </div>
            `;
            wrapper.appendChild(card);
        });
        updateProgressBar();
    }

    window.handleSelection = (index, value, type) => {
        scores[type] += value;
        
        const currentCard = document.getElementById(`q-${index}`);
        currentCard.classList.remove('active');

        if (index + 1 < questions.length) {
            currentStep++;
            const nextCard = document.getElementById(`q-${index + 1}`);
            nextCard.classList.add('active');
            updateProgressBar();
        } else {
            showResults();
        }
    };

    function updateProgressBar() {
        const percent = ((currentStep) / questions.length) * 100;
        document.getElementById('progress-fill').style.width = percent + "%";
    }

    function showResults() {
        document.getElementById('progress-fill').style.width = "100%";
        document.getElementById('questions-wrapper').style.display = 'none';
        document.getElementById('result-container').style.display = 'block';

        // O máximo por categoria é 20 pontos (4 perguntas * 5)
        const maxScore = 20;

        // Atualizar barras
        for (const profile in scores) {
            const bar = document.getElementById(`bar-${profile}`);
            const percentage = (scores[profile] / maxScore) * 100;
            bar.style.width = percentage + "%";
        }

        // Calcular Vencedor e Menos Desenvolvido
        const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
        const winnerKey = sorted[0][0];
        const weakerKey = sorted[sorted.length - 1][0];

        const summary = document.getElementById('winner-summary');
        summary.innerHTML = `
            <h3 style="color:var(--accent-blue); margin-bottom:10px;">Perfil Predominante: ${profilesData[winnerKey].title}</h3>
            <p style="margin-bottom:20px; font-size: 0.95rem; line-height:1.6;">${profilesData[winnerKey].desc}</p>
            <hr style="opacity:0.1; margin: 15px 0;">
            <p style="font-size:0.85rem; opacity:0.8;">
                <strong>Ponto de Atenção:</strong> Seu perfil menos desenvolvido é <strong>${profilesData[weakerKey].title}</strong>. 
                Considere trabalhar competências ligadas a este fluxo para atingir a maestria do Líder Flow.
            </p>
        `;
    }

    initQuiz();
</script>

</body>
</html>
